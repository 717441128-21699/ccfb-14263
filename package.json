{
  "name": "underwater-restore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Physics-based underwater photo restoration: depth/distance-aware attenuation + backscatter separation, strobe/ambient dual-path, WebGL2 pipeline",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/benchmark.ts",
    "perf": "tsx scripts/perf.ts",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "gl:install": "playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "optionalDependencies": {
    "playwright": "^1.48.2"
  }
}
